# ---- Meterless Runtime (primary LLM provider, provider contract v4) ----
# Nightshift / Meterless Runtime writes its token to <stateDir>/proxy-token.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
# or paste a connect link instead of the two values above:
# METERLESS_CONNECT_LINK=http://127.0.0.1:8088/connect#k=...

# ---- Fallback provider (used ONLY on a transport failure to Meterless) ----
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_GUARD_MODEL=nvidia/nemotron-3.5-content-safety

# ---- Zetaris (federated SQL) ----
# Real Zetaris Docker bundle: http://localhost:8888/api/v1.0
# Local simulator (npm run zetaris:sim): http://127.0.0.1:8899/api/v1.0
ZETARIS_REST_URL=http://127.0.0.1:8899/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=sim-local-key

# ---- Monad testnet (read-only) ----
MONAD_RPC_URLS=https://monad-testnet.drpc.org,https://testnet-rpc.monad.xyz
